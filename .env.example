# Duck Debugger — Configuration template (.env)
# Copier ce fichier à .env et remplir les valeurs réelles.
# NE PAS committer le fichier .env (contient des secrets).

# ============================================================================
# MISTRAL API - REQUIS
# ============================================================================
# Obtenir une clé sur https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# Modèle principal pour les réponses
MODEL_NAME=ministral-8b-latest

# Modèle de fallback en cas de rate limit
FALLBACK_MODEL=mistral-small-latest

# ============================================================================
# CLASSE - REQUIS
# ============================================================================
# Mot de passe pour accéder au chat (à donner aux étudiants)
CLASS_PASSWORD=change_me_to_a_strong_password

# ============================================================================
# RATE LIMITING
# ============================================================================
# Limite par étudiant (protège le budget et Mistral rate limit)
MAX_REQUESTS_PER_DAY_PER_SESSION=50

# Limite totale pour la classe
MAX_REQUESTS_PER_DAY_GLOBAL=500

# Tokens max par réponse (contrôle le coût)
MAX_TOKENS_PER_REPLY=400

# ============================================================================
# EMAIL - OPTIONNEL
# ============================================================================
# Clé SendGrid pour envoyer les suggestions par email
# Laisser vide = feedback sauvegardé localement
# Obtenir sur https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
